        "title": "Registration"
      },
      "RunView": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "cancel_requested": {
            "type": "boolean",
            "title": "Cancel Requested"
          },
          "operation": {
            "type": "string",
            "enum": [
              "pack",
              "benchmark",
              "optimize"
            ],
            "title": "Operation"
          },
          "repository_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Repository Id"
          },
          "execution": {
            "type": "string",
            "enum": [
              "local",
              "daytona"
            ],
            "title": "Execution"
          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved",
            "default": false
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactView"
            },
            "type": "array",
            "title": "Artifacts"
          },
          "metrics": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metrics"
          },
          "reports": {
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "object",
            "title": "Reports"
          },
          "sandboxes": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Sandboxes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
