          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "execution": {
            "type": "string",
            "enum": [
              "local",
              "daytona"
            ],
            "title": "Execution",
            "default": "local"
          },
          "approved_snapshot": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved Snapshot"
          },
          "repeats": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Repeats",
            "default": 3
          },
          "warmups": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Warmups",
            "default": 1
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "dictionary_ids": {
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Dictionary Ids"
          },
          "splits": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Splits"
              },
              {
                "type": "null"
              }
            ]
          },
          "partition_repository_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Partition Repository Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "repository_id",
          "operation"
        ],
        "title": "Submission"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
