      "Limits": {
        "properties": {
          "encode_seconds": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Encode Seconds",
            "default": 300.0
          },
          "decode_seconds": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Decode Seconds",
            "default": 300.0
          },
          "peak_memory_bytes": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Peak Memory Bytes",
            "default": 1073741824
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Limits"
      },
      "Policy": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 1.0,
            "title": "Schema Version",
            "default": 1
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "default": "baseline"
          },
          "codec": {
            "type": "string",
            "enum": [
              "stored",
              "zstd",
              "lzma"
            ],
            "title": "Codec",
            "default": "zstd"
          },
          "zstd_level": {
            "type": "integer",
            "maximum": 22.0,
            "minimum": -7.0,
            "title": "Zstd Level",
            "default": 3
          },
          "dictionary_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dictionary Id"
          },
          "grouping": {
            "type": "string",
            "enum": [
              "none",
              "extension",
              "graph"
            ],
            "title": "Grouping",
            "default": "none"
          },
          "solid_block_bytes": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 67108864.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Solid Block Bytes"
          },
          "metadata_encoding": {
            "type": "string",
            "enum": [
              "json",
              "compressed",
              "compact"
            ],
            "title": "Metadata Encoding",
            "default": "json"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Policy"
      },
      "PolicyView": {
        "properties": {
          "policy_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Policy Id"
          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "promoted": {
            "type": "boolean",
            "title": "Promoted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "policy_id",
          "policy",
          "promoted"
        ],
        "title": "PolicyView"
      },
      "Registration": {
        "properties": {
          "fixture": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "title": "Fixture"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fixture"
