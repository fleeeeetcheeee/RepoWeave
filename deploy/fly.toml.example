# Copy to .repoweave/hosting/fly.toml and replace YOUR_APP.
app = "YOUR_APP"
primary_region = "iad"
kill_signal = "SIGTERM"
kill_timeout = 30

[build]
  dockerfile = "deploy/hosting.Dockerfile"
  ignorefile = "deploy/hosting.Dockerfile.dockerignore"

[env]
  REPOWEAVE_HOSTING_CONFIG = "/app/hosting.json"
  REPOWEAVE_DATA_DIR = "/data/repoweave"
  REPOWEAVE_EXECUTION = "local"
  REPOWEAVE_ALLOW_REMOTE_DATA = "false"
  LANGSMITH_TRACING = "false"

[[files]]
  guest_path = "/app/hosting.json"
  local_path = "hosting.json"

[[mounts]]
  source = "repoweave_data"
  destination = "/data"

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1
  [http_service.concurrency]
    type = "requests"
    soft_limit = 16
    hard_limit = 32
  [[http_service.checks]]
    grace_period = "20s"
    interval = "30s"
    method = "GET"
    timeout = "5s"
    path = "/health"
    [http_service.checks.headers]
      Host = "YOUR_APP.fly.dev"

[[vm]]
  cpu_kind = "shared"
  cpus = 1
  memory = "2gb"
